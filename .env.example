# Application Configuration
APP_NAME=Inquvia
MONGODB_URI=
MONGODB_DB_NAME=

# FastAPI backend URL for the Next.js /api rewrite proxy.
# Local dev: http://127.0.0.1:8000 . Leave empty if the backend serves the SPA.
BACKEND_API_URL=http://127.0.0.1:8000

# Multi-Provider AI Keys (Auto-fallback in order: Gemini -> Groq -> OpenRouter -> OpenAI)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Algorand / x402 Protocol
# Set to "mainnet" for production. "testnet" for testing with test USDC.
ALGORAND_NETWORK=testnet
# Client-bundle copy of the network. MUST match ALGORAND_NETWORK. It is inlined
# into client components so "testnet/mainnet" breadcrumbs render identically on
# server and client (otherwise React hydration fails). Add the same line to .env.
NEXT_PUBLIC_ALGORAND_NETWORK=testnet
# TestNet USDC ASA (10458941). MainNet USDC ASA is 31566704.
ALGORAND_USDC_ASA=10458941
X402_FACILITATOR_URL=https://facilitator.goplausible.com
X402_CHALLENGE_TAG=x402-global-challenge

# Real Pera Wallet signing (Pera connect needs NO project id)
# Algod node for the configured network. Leave ALGOD_SERVER empty to default to
# https://testnet-api.algonode.cloud (testnet) or https://mainnet-api.algonode.cloud (mainnet).
ALGOD_SERVER=
ALGOD_TOKEN=
ALGOD_PORT=443

# Orchestrator (Inquvia runs atomic x402-paid endpoints; the client pays Inquvia's
# wallet, then Inquvia's backend pays downstream evidence services from its own wallet)
# Inquvia's USDC receiving address for the capability fees (Algorand address, opted in to USDC)
INQUVIA_PAYTO_ADDRESS=
# Per-capability prices in whole USDC dollars (one micro amount per capability; distinct prices)
CLAIM_INVESTIGATION_PRICE_USDC=0.005
IMAGE_INVESTIGATION_PRICE_USDC=0.008
VIDEO_INVESTIGATION_PRICE_USDC=0.015
DOCUMENT_INVESTIGATION_PRICE_USDC=0.007
SOURCE_INVESTIGATION_PRICE_USDC=0.006
DATA_INVESTIGATION_PRICE_USDC=0.012

# Real external evidence service discovery (Bazaar catalog URL, or inline JSON)
# EXTERNAL_EVIDENCE_SERVICES_URL=https://...
# EXTERNAL_EVIDENCE_SERVICES_JSON=name|https://host/path|capability1,capability2|0.01

# --- Offline test runner (npm test / npm run test:matrix) ---------------------
# Everything the tests use comes from env, no fallbacks. All below are REQUIRED.
# Algod node URL the testnet-matrix uses to sign/verify real testnet USDC txn.
X402_ALGOD_URL=https://testnet-api.algonode.cloud
# TestNet USDC ASA id. Same as ALGORAND_USDC_ASA when on testnet.
TESTNET_USDC_ASA_ID=10458941


