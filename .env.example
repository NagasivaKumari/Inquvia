# Backend URL for the paid / api routes.
# Local dev backend: http://127.0.0.1:8000
# Vercel production: https://inquvia.onrender.com  (REQUIRED on Vercel — the
# build fails without it so blank deployments can't ship.)
NEXT_PUBLIC_API_URL=https://inquvia.onrender.com

# Render (serving the exported static site) needs nothing here: /api calls are
# relative to the Render origin.